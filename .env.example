DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password

DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=change_me
DEFAULT_CASHIER_USER=cashier
DEFAULT_CASHIER_PASSWORD=change_me

TAX_RATE=0.08875

# Exact Windows printer name for the receipt printer — run list_printers.py
# on the register PC to find it.
PRINTER_NAME=your_printer_name

# Toggled from Settings in the app — not meant to be hand-edited normally.
CUSTOMER_DISPLAY_ENABLED=false
CUSTOMER_DISPLAY_MONITOR=auto
CUSTOMER_DISPLAY_RESOLUTION=auto
CUSTOMER_DISPLAY_LINE1=Your Store Name
CUSTOMER_DISPLAY_LINE2=Your Store Address
CUSTOMER_DISPLAY_LINE3=Your Store Phone

# Scales the main app windows (login, dashboard, sales, etc.) — compensates
# for the fixed 96-DPI font scaling needed to keep the customer display
# from blowing up on a differently-scaled secondary monitor.
UI_SCALE=1.0

# Which monitor the main app windows (login, dashboard, sales, inventory,
# reports) open full-screen on.
MAIN_MONITOR=auto
